# Official SearXNG container version.
SEARXNG_VERSION=latest

# Container HTTP listener. The Docker port mapping keeps this private to localhost.
SEARXNG_PORT=8083
SEARXNG_BIND_ADDRESS=0.0.0.0
SEARXNG_BASE_URL=http://127.0.0.1:8083/

# Local-only defaults for a bot-facing instance.
SEARXNG_SECRET=shorekeeper-local-search-secret
SEARXNG_LIMITER=false
SEARXNG_IMAGE_PROXY=false
SEARXNG_PUBLIC_INSTANCE=false
SEARXNG_VALKEY_URL=valkey://valkey:6379/0

# Avoid ownership churn on repo-mounted config files.
FORCE_OWNERSHIP=false

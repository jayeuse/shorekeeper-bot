DISCORD_TOKEN=your_discord_bot_token

# Optional remote fallback
ONLINE_API_KEY=your_deepseek_api_key
ONLINE_BASE_URL=https://api.deepseek.com
ONLINE_MODEL=deepseek-chat

# Local llama.cpp chat server
LLM_PROVIDER=llamacpp
LLAMA_BIN_DIR=$HOME/llama.cpp/build/bin
LOCAL_BASE_URL=http://127.0.0.1:8081/v1
LOCAL_API_KEY=no-key
LOCAL_MODEL=shorekeeper
CHAT_MODEL_PATH=/mnt/sdb4/models/shorekeeper.gguf

# Local llama.cpp embedding server
EMBEDDING_PROVIDER=llamacpp
EMBED_BASE_URL=http://127.0.0.1:8082/v1
EMBED_API_KEY=no-key
EMBED_MODEL=nomic-embed-text
EMBED_MODEL_PATH=/mnt/sdb4/models/nomic-embed-text.gguf

# llama.cpp runtime tuning used by scripts/start-llama-local.sh
GPU_LAYERS=999
THREADS=12
LOCAL_CONTEXT_WINDOW=65536
CHAT_PARALLEL=1
CHAT_TEMPERATURE=0.3
CHAT_TOP_P=0.9
CHAT_TOP_K=40
CHAT_REPEAT_PENALTY=1.05
CHAT_FLASH_ATTN=on
CHAT_CACHE_TYPE_K=q4_0
CHAT_CACHE_TYPE_V=q4_0
CHAT_JINJA=--jinja
CHAT_NO_MMAP=--no-mmap
EMBED_POOLING=cls
EMBED_NO_MMAP=--no-mmap
LLAMA_METRICS=--metrics
LOCAL_KV_CACHE_KEEP=4
MEMORY_ENABLED=true

# Live search grounding
SEARCH_ENABLED=true
SEARCH_PROVIDER=searxng
SEARCH_BASE_URL=http://127.0.0.1:8083
SEARCH_TIMEOUT_SECONDS=8
SEARCH_MAX_RESULTS=5
SEARCH_MIN_QUERY_LENGTH=5
SEARCH_TRIGGER_MODE=hybrid
SEARCH_EXPLICIT_PREFIX=search:
SEARCH_CURRENT_HINTS="latest,current,today,news,update,look up,search"
SEARCH_SAFE_DOMAINS=
SEARCH_BLOCK_PRIVATE_IPS=true
SEARCH_TRUSTED_DOMAINS_OFFICIAL=hoyoverse.com,genshin.hoyoverse.com,kurogames.com,wutheringwaves.kurogames.com,nvidia.com,investor.nvidia.com,nasdaq.com
SEARCH_TRUSTED_DOMAINS_REFERENCE=wikipedia.org,www.wikipedia.org,wikidata.org,investopedia.com,finance.yahoo.com,merriam-webster.com,britannica.com
SEARCH_TRUSTED_DOMAINS_NEWS=reuters.com,www.reuters.com,bloomberg.com,www.bloomberg.com,cnbc.com,www.cnbc.com,apnews.com,ign.com,www.ign.com,gamespot.com,www.gamespot.com,polygon.com,www.polygon.com
SEARCH_DEMOTED_DOMAINS=youtube.com,www.youtube.com,reddit.com,www.reddit.com,play.google.com,apps.apple.com,tiktok.com,www.tiktok.com,x.com,www.x.com,instagram.com,www.instagram.com,facebook.com,www.facebook.com
SEARCH_TOPIC_DOMAIN_OVERRIDES={"finance":{"preferred":["nasdaq.com","finance.yahoo.com","reuters.com","bloomberg.com","marketwatch.com"]},"game":{"preferred":["hoyoverse.com","genshin.hoyoverse.com","kurogames.com","wutheringwaves.kurogames.com","ign.com","gamespot.com"]},"language":{"preferred":["merriam-webster.com","britannica.com","wikipedia.org"]}}

# Analysis/search orchestration
ANALYSIS_ENABLED=true
ANALYSIS_TIMEOUT_SECONDS=6
RAG_ANSWER_SCORE_THRESHOLD=0.62
GENERAL_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.70

# Legacy transition knobs
ROUTER_ENABLED=true
ROUTER_HISTORY_TURNS=4
ROUTER_TIMEOUT_SECONDS=6
ROUTER_MAX_QUERY_CHARS=240
ANSWERABILITY_ENABLED=true
ANSWERABILITY_TIMEOUT_SECONDS=6
DIRECT_ANSWER_CONFIDENCE_THRESHOLD=0.75
SEARCH_FALLBACK_CONFIDENCE_THRESHOLD=0.55

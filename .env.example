DISCORD_TOKEN=your_discord_bot_token

# Runtime mode: "local" or "online"
MODE=local

# Online provider base URL (OpenAI-compatible endpoint)
ONLINE_BASE_URL=https://openrouter.ai/api/v1

# Online API key (used for both LLM and embedding when MODE=online)
ONLINE_LLM_API_KEY=your_openrouter_api_key

# Local API keys (use "no-key" for llama.cpp)
LOCAL_API_KEY=no-key
EMBED_API_KEY=no-key

# Online model names (required when MODE=online)
ONLINE_LLM_MODEL=google/gemma-4-31b-it:free
ONLINE_EMBEDDER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Database connection (required when MODE=online)
# DATABASE_URL=postgresql://user:password@host:port/database

# Feature toggles
MEMORY_ENABLED=true
SEARCH_ENABLED=false
